    },
    "When you leave Runfern, iPadOS may pause running builds or servers. Saved files are not affected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wenn du Runfern verlässt, kann iPadOS laufende Builds oder Server anhalten. Gesicherte Dateien sind davon nicht betroffen."
          }
        }
      }
    },
    "While you were editing, a sync changed this file. Which version should be kept?" : {
